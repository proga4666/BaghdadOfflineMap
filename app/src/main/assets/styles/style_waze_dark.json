{
  "version": 8,
  "name": "Google Maps Clean Road Style",
  "sources": {
    "google-clean-roads": {
      "type": "raster",
      "tiles": [
        "https://mt0.google.com/vt/lyrs=r&x={x}&y={y}&z={z}",
        "https://mt1.google.com/vt/lyrs=r&x={x}&y={y}&z={z}",
        "https://mt2.google.com/vt/lyrs=r&x={x}&y={y}&z={z}",
        "https://mt3.google.com/vt/lyrs=r&x={x}&y={y}&z={z}"
      ],
      "tileSize": 256,
      "attribution": "© Google Maps",
      "maxzoom": 21
    }
  },
  "layers": [
    {
      "id": "google-clean-roads-layer",
      "type": "raster",
      "source": "google-clean-roads",
      "minzoom": 0,
      "maxzoom": 22
    }
  ]
}
