<?xml version="1.0" encoding="UTF-8"?>
<rendertheme xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" map-background="#EDEDED"
    map-background-outside="#D0D0D0" version="5" xmlns="http://mapsforge.org/renderTheme"
    xsi:schemaLocation="http://mapsforge.org/renderTheme https://raw.githubusercontent.com/mapsforge/mapsforge/master/resources/renderTheme.xsd">

    <!-- Water / Tigris River (High Contrast Deep Blue) -->
    <rule e="way" k="natural|waterway|water" v="water|river|riverbank|canal|lake|sea">
        <area fill="#4A90E2" stroke="#1A5AA8" stroke-width="0.8" />
    </rule>

    <!-- Parks / Green Spaces -->
    <rule e="way" k="leisure|landuse|natural" v="park|garden|grass|meadow|forest|wood" zoom-min="11">
        <area fill="#A8D5BA" stroke="#79B890" stroke-width="0.5" />
    </rule>

    <!-- Residential / Urban Blocks -->
    <rule e="way" k="landuse" v="residential" zoom-min="13">
        <area fill="#E2E2E2" />
    </rule>

    <!-- Highways / Motorways (Ultra Bold High-Vis Yellow/Orange) -->
    <rule e="way" k="highway" v="motorway|trunk|motorway_link|trunk_link">
        <line stroke="#000000" stroke-width="4.2" stroke-linecap="round" />
        <line stroke="#FFC107" stroke-width="3.2" stroke-linecap="round" />
        <pathText k="name" font-size="12" font-style="bold" fill="#000000" stroke="#FFFFFF" stroke-width="2.5" />
    </rule>

    <!-- Primary & Secondary Roads (Bold Blue Casing / White Fill) -->
    <rule e="way" k="highway" v="primary|secondary|primary_link|secondary_link">
        <line stroke="#1565C0" stroke-width="3.2" stroke-linecap="round" />
        <line stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" />
        <pathText k="name" font-size="11" font-style="bold" fill="#000000" stroke="#FFFFFF" stroke-width="2.2" />
    </rule>

    <!-- Tertiary Roads -->
    <rule e="way" k="highway" v="tertiary|unclassified">
        <line stroke="#757575" stroke-width="2.4" stroke-linecap="round" />
        <line stroke="#FFFFFF" stroke-width="1.6" stroke-linecap="round" />
        <pathText k="name" font-size="10" fill="#000000" stroke="#FFFFFF" stroke-width="2.0" zoom-min="14" />
    </rule>

    <!-- Residential Streets & Alleys -->
    <rule e="way" k="highway" v="residential|living_street|service|road" zoom-min="13">
        <line stroke="#9E9E9E" stroke-width="1.8" stroke-linecap="round" />
        <line stroke="#FFFFFF" stroke-width="1.1" stroke-linecap="round" />
        <pathText k="name" font-size="9" fill="#212121" stroke="#FFFFFF" stroke-width="2.0" zoom-min="15" />
    </rule>

    <!-- Landmarks Labels -->
    <rule e="node" k="place" v="city|suburb|neighbourhood|quarter">
        <caption k="name" font-size="14" font-style="bold" fill="#D32F2F" stroke="#FFFFFF" stroke-width="3.0" />
    </rule>

</rendertheme>
