<?xml version="1.0" encoding="UTF-8"?>
<rendertheme xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" map-background="#1E232B"
    map-background-outside="#14181E" version="5" xmlns="http://mapsforge.org/renderTheme"
    xsi:schemaLocation="http://mapsforge.org/renderTheme https://raw.githubusercontent.com/mapsforge/mapsforge/master/resources/renderTheme.xsd">

    <!-- 1. Land Base -->
    <rule e="way" k="natural" v="nosea|land">
        <area fill="#1E232B" />
    </rule>

    <!-- 2. Water / Tigris River (Solid Deep Calm Navy - Waze Style) -->
    <rule e="way" k="waterway" v="riverbank|dock">
        <area fill="#1B3F68" />
    </rule>
    <rule e="way" k="natural" v="water|lake">
        <area fill="#1B3F68" />
    </rule>
    <rule e="way" k="landuse" v="reservoir|basin">
        <area fill="#1B3F68" />
    </rule>
    <rule e="way" k="waterway" v="river">
        <line stroke="#1B3F68" stroke-width="4.0" stroke-linecap="round" />
        <pathText k="name" font-size="12" font-style="bold" fill="#8AB4F8" stroke="#101824" stroke-width="2.0" zoom-min="12" />
    </rule>
    <rule e="way" k="waterway" v="canal|stream|drain">
        <line stroke="#1B3F68" stroke-width="1.8" stroke-linecap="round" />
    </rule>

    <!-- 3. Parks, Forests & Islands (Solid Rich Green - Waze Style) -->
    <rule e="way" k="leisure" v="park|garden|pitch|playground|nature_reserve">
        <area fill="#1B4D38" />
    </rule>
    <rule e="way" k="landuse" v="grass|forest|meadow|orchard|village_green|cemetery">
        <area fill="#1B4D38" />
    </rule>
    <rule e="way" k="natural" v="wood|scrub|grassland">
        <area fill="#1B4D38" />
    </rule>

    <!-- 4. Urban Blocks & Buildings (Clean Flat Dark Tiles - No Noise) -->
    <rule e="way" k="landuse" v="residential|commercial|retail" zoom-min="13">
        <area fill="#232933" />
    </rule>
    <rule e="way" k="building" v="*" zoom-min="15">
        <area fill="#29303D" />
    </rule>

    <!-- 5. Major Highways, Freeways & Bridges (Clean Slate Blue/Grey) -->
    <rule e="way" k="highway" v="motorway|trunk|motorway_link|trunk_link">
        <line stroke="#2B3645" stroke-width="3.6" stroke-linecap="round" />
        <line stroke="#556984" stroke-width="2.6" stroke-linecap="round" />
        <pathText k="name" font-size="11" font-style="bold" fill="#FFFFFF" stroke="#1A202A" stroke-width="2.0" />
    </rule>

    <!-- 6. Primary Avenues & Main Roads (Clean Light Slate) -->
    <rule e="way" k="highway" v="primary|primary_link|secondary|secondary_link">
        <line stroke="#232B36" stroke-width="2.6" stroke-linecap="round" />
        <line stroke="#475569" stroke-width="1.8" stroke-linecap="round" />
        <pathText k="name" font-size="10" fill="#FFFFFF" stroke="#1A202A" stroke-width="2.0" />
    </rule>

    <!-- 7. Tertiary Neighborhood Avenues -->
    <rule e="way" k="highway" v="tertiary|unclassified">
        <line stroke="#384353" stroke-width="1.4" stroke-linecap="round" />
        <pathText k="name" font-size="9" fill="#E2E8F0" stroke="#1A202A" stroke-width="1.5" zoom-min="14" />
    </rule>

    <!-- 8. Residential Streets & Alleys (Clean Single Subtle Line) -->
    <rule e="way" k="highway" v="residential|living_street|service|road" zoom-min="13">
        <line stroke="#2D3644" stroke-width="1.0" stroke-linecap="round" />
        <pathText k="name" font-size="8" fill="#CBD5E1" stroke="#1A202A" stroke-width="1.5" zoom-min="15" />
    </rule>

    <!-- 9. Neighborhood & District Labels (Clean White Text) -->
    <rule e="node" k="place" v="city|suburb|neighbourhood|quarter">
        <caption k="name" font-size="13" font-style="bold" fill="#FFFFFF" stroke="#10141A" stroke-width="2.5" />
    </rule>

    <!-- 10. Clean Minimalist POIs -->
    <rule e="any" k="amenity" v="hospital|clinic|pharmacy" zoom-min="15">
        <circle r="3.5" fill="#EF4444" stroke="#FFFFFF" stroke-width="0.8" />
        <caption k="name" font-size="8" fill="#FCA5A5" stroke="#1A202A" stroke-width="1.5" zoom-min="16" />
    </rule>

    <rule e="any" k="amenity" v="place_of_worship|mosque" zoom-min="15">
        <circle r="3.5" fill="#10B981" stroke="#FFFFFF" stroke-width="0.8" />
        <caption k="name" font-size="8" fill="#6EE7B7" stroke="#1A202A" stroke-width="1.5" zoom-min="16" />
    </rule>

    <rule e="any" k="amenity" v="restaurant|cafe|fast_food" zoom-min="16">
        <circle r="3" fill="#F59E0B" />
        <caption k="name" font-size="8" fill="#FDE68A" stroke="#1A202A" stroke-width="1.5" zoom-min="17" />
    </rule>

</rendertheme>
