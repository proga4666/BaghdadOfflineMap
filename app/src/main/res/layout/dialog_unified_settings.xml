<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="#CCCCCC" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Navigation &amp; Map Settings"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Manage offline maps, live traffic engine, and cartography themes."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- 1. Map Theme Selection Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎨 Map Theme &amp; Style"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/radioGroupMapThemes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/radioThemeWazeDark"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🚗 Waze Dark (Clean &amp; Minimalist)"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/radioThemeWazeLight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="☀️ Waze Light (Clean Minimalist)"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/radioThemeLightModern"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🗺️ Google Maps Clean Style"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/radioThemeDarkMidnight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🌙 Midnight Dark (High-Contrast)"
                        android:textSize="13sp" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Routing Strategy & Live Traffic Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚦 Routing Engine &amp; Traffic"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/radioGroupRoutingMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/radioAuto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔄 Auto (Live Traffic when online, GraphHopper offline)"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/radioGoogleTraffic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🟢 Google Directions (Live Traffic Preferred)"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/radioOfflineGraphHopper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚡ 100% Offline (GraphHopper Local Graph Only)"
                        android:textSize="13sp" />
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Google Maps API Key (Optional for Live Traffic)"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutApiKey"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:boxStrokeColor="@color/primary"
                    app:endIconMode="clear_text"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etGoogleApiKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="AIzaSy..."
                        android:inputType="textNoSuggestions"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Search Engine / Geocoding Provider Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍 Place Search Engine"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/radioGroupSearchMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/radioSearchAuto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔄 Auto (Google -> Free Photon OSM -> Offline)"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/radioSearchGoogle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🟢 Google Places API (With Key)"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/radioSearchPhoton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🌐 Photon / OpenStreetMap (100% Free Online, No Key)"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/radioSearchOffline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚡ Local Offline Index Only"
                        android:textSize="13sp" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Offline Maps Management Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗺️ Offline Map Storage"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvActiveMapStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Active Map: iraq.map (98 MB)"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManageOfflinePackages"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Download &amp; Update Offline Maps"
                    app:icon="@drawable/ic_download" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. Learned Corridors Statistics -->
        <TextView
            android:id="@+id/tvLearningStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_download_banner"
            android:padding="10dp"
            android:text="💾 Saved Trips: 0  •  🧠 Google-Preferred Corridors: 0"
            android:textColor="@color/primary_dark"
            android:textSize="12sp" />

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveAllSettings"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Save &amp; Apply" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
