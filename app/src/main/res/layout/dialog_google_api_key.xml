<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="#CCCCCC" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Navigation &amp; Live Traffic Settings"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Configure Google Directions with live traffic and offline learning cache."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="@color/divider" />

    <!-- Routing Mode Radio Group -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Routing Strategy"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/radioGroupRoutingMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <RadioButton
            android:id="@+id/radioAuto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄 Auto (Google Traffic when online, GraphHopper when offline)"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/radioGoogleTraffic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🟢 Google Directions (Live Traffic Preferred)"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/radioOfflineGraphHopper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡ 100% Offline (GraphHopper Local Graph Only)"
            android:textSize="13sp" />
    </RadioGroup>

    <!-- Google API Key Input Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Google Maps Directions API Key"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inputLayoutApiKey"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:boxStrokeColor="@color/primary"
        app:endIconMode="clear_text"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etGoogleApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="AIzaSy..."
            android:inputType="textNoSuggestions"
            android:textSize="13sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Cache stats info -->
    <TextView
        android:id="@+id/tvCacheStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_download_banner"
        android:padding="8dp"
        android:text="💾 Saved Routes in Cache: 0 trips"
        android:textColor="@color/primary_dark"
        android:textSize="12sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelSettings"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Close" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveSettings"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Save &amp; Apply" />
    </LinearLayout>

</LinearLayout>
